  <style>
    :root{
      --navy:#10243b;--navy2:#173653;--blue:#1769e0;--blue2:#2d83f5;
      --cyan:#35c5dc;--ink:#17283d;--muted:#617187;--pale:#f2f7fc;
      --line:#e1eaf3;--white:#fff;--green:#19a879;--shadow:0 18px 55px rgba(16,36,59,.12);
      --radius:22px
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",Arial,sans-serif;color:var(--ink);line-height:1.6;background:#fff}
    a{text-decoration:none;color:inherit}
    .container{width:min(1160px,calc(100% - 40px));margin:auto}
    .topbar{background:var(--navy);color:#dce8f5;font-size:13px;padding:9px 0}
    .topbar .container{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
    .topbar a{color:#fff}
    header{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.96);backdrop-filter:blur(12px);border-bottom:1px solid rgba(225,234,243,.8)}
    .nav{height:76px;display:flex;align-items:center;justify-content:space-between;gap:24px}
    .logo{font-size:25px;font-weight:850;letter-spacing:-1.2px;color:var(--navy)}
    .logo span{color:var(--blue)}
    .navlinks{display:flex;align-items:center;gap:27px;font-size:14px;font-weight:650;color:#40546b}
    .navlinks a:hover{color:var(--blue)}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:13px 21px;border-radius:10px;background:var(--blue);color:white;font-weight:750;font-size:14px;box-shadow:0 8px 22px rgba(23,105,224,.2);transition:.2s}
    .btn:hover{background:#0e56c3;transform:translateY(-1px)}
    .btn-outline{background:#fff;color:var(--navy);border:1px solid #cdd9e6;box-shadow:none}
    .btn-outline:hover{background:#f5f9ff;color:var(--blue)}
    .menu-toggle{display:none;border:0;background:none;font-size:26px;color:var(--navy);cursor:pointer}
    .hero{position:relative;overflow:hidden;background:radial-gradient(circle at 82% 25%,rgba(53,197,220,.22),transparent 28%),linear-gradient(125deg,#0d2036 0%,#153c61 58%,#155c9b 100%);color:#fff;padding:88px 0 96px}
    .hero:after{content:"";position:absolute;width:540px;height:540px;border:1px solid rgba(255,255,255,.1);border-radius:50%;right:-180px;bottom:-330px;box-shadow:0 0 0 55px rgba(255,255,255,.025),0 0 0 110px rgba(255,255,255,.02)}
    .hero-grid{display:grid;grid-template-columns:1.02fr .98fr;align-items:center;gap:55px;position:relative;z-index:1}
    .eyebrow{display:inline-flex;align-items:center;gap:8px;color:#a9e9f2;background:rgba(53,197,220,.12);border:1px solid rgba(120,222,236,.25);padding:7px 12px;border-radius:50px;font-size:12px;font-weight:800;letter-spacing:.8px;text-transform:uppercase}
    h1{font-size:clamp(39px,5.2vw,62px);line-height:1.08;letter-spacing:-2.4px;margin:22px 0 20px;max-width:680px}
    .hero p{font-size:18px;color:#d3e1ef;max-width:580px;margin:0 0 29px}
    .hero-actions{display:flex;gap:13px;flex-wrap:wrap}
    .hero .btn-outline{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.3);color:#fff}
    .hero .btn-outline:hover{background:rgba(255,255,255,.16)}
    .hero-points{display:flex;gap:20px;flex-wrap:wrap;margin-top:27px;color:#c7d8e8;font-size:13px}
    .hero-points span:before{content:"✓";color:#62e1bd;font-weight:900;margin-right:7px}
    .dashboard-wrap{position:relative}
    .dashboard{background:#fff;border-radius:18px;padding:17px;color:var(--ink);box-shadow:0 30px 75px rgba(0,0,0,.28);transform:rotate(1deg)}
    .dash-top{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding:2px 2px 15px}
    .dash-brand{font-size:13px;font-weight:850;color:var(--navy)}
    .dash-user{width:28px;height:28px;border-radius:50%;background:#dceaff;color:#1769e0;display:grid;place-items:center;font-size:11px;font-weight:800}
    .dash-title{display:flex;justify-content:space-between;align-items:center;margin:17px 0 12px}
    .dash-title strong{font-size:17px}
    .dash-title small{font-size:10px;color:var(--muted)}
    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}
    .stat{background:#f4f8fd;padding:12px;border-radius:10px}
    .stat small{display:block;color:#718197;font-size:9px;font-weight:700}
    .stat b{display:block;font-size:20px;color:var(--navy);margin-top:3px}
    .stat em{font-style:normal;color:var(--green);font-size:9px}
    .calendar{margin-top:15px;border:1px solid var(--line);border-radius:11px;padding:12px}
    .cal-head{display:flex;justify-content:space-between;font-size:11px;font-weight:800;margin-bottom:10px}
    .cal-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
    .cal-cell{height:44px;border-radius:7px;background:#f5f8fc;padding:5px;font-size:8px;color:#718197}
    .cal-cell b{display:block;font-size:10px;color:var(--ink)}
    .cal-cell.active{background:#e5f0ff;border:1px solid #a9cbff}
    .cal-cell.active b{color:var(--blue)}
    .booking-tag{display:block;background:#dff7f0;color:#12805e;border-radius:4px;padding:2px 3px;margin-top:3px;font-size:7px}
    .floating-note{position:absolute;right:-22px;bottom:-25px;background:white;color:var(--ink);padding:13px 16px;border-radius:13px;box-shadow:var(--shadow);font-size:11px;font-weight:750}
    .floating-note span{display:block;color:var(--green);font-size:10px;font-weight:650}
    .trust{padding:25px 0;border-bottom:1px solid var(--line);text-align:center}
    .trust p{margin:0;color:#718197;font-size:12px;font-weight:800;letter-spacing:1px;text-transform:uppercase}
    .trust-list{display:flex;justify-content:center;gap:38px;flex-wrap:wrap;margin-top:13px;color:#53667c;font-size:14px;font-weight:750}
    section{padding:82px 0}
    .section-head{text-align:center;max-width:730px;margin:0 auto 43px}
    .kicker{font-size:12px;color:var(--blue);font-weight:850;letter-spacing:1.2px;text-transform:uppercase}
    h2{font-size:clamp(30px,4vw,43px);line-height:1.15;letter-spacing:-1.3px;color:var(--navy);margin:12px 0}
    .section-head p{color:var(--muted);font-size:16px;margin:0}
    .feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .feature{border:1px solid var(--line);border-radius:16px;padding:25px;background:#fff;transition:.2s}
    .feature:hover{transform:translateY(-4px);box-shadow:var(--shadow);border-color:#c9dcf4}
    .feature-icon{width:46px;height:46px;border-radius:13px;background:#eaf3ff;color:var(--blue);display:grid;place-items:center;font-size:21px;margin-bottom:17px}
    .feature h3{font-size:18px;margin:0 0 8px;color:var(--navy)}
    .feature p{font-size:14px;color:var(--muted);margin:0}
    .workflow{background:var(--pale)}
    .steps{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}
    .step{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px 14px;text-align:center;position:relative}
    .step-num{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:#e6f1ff;color:var(--blue);font-weight:850;font-size:13px;margin:0 auto 12px}
    .step strong{display:block;font-size:13px;color:var(--navy)}
    .step small{display:block;color:var(--muted);font-size:11px;margin-top:5px}
    .split{display:grid;grid-template-columns:1fr 1fr;gap:65px;align-items:center}
    .split-copy h2{margin-top:10px}
    .split-copy>p{color:var(--muted)}
    .check-list{list-style:none;padding:0;margin:24px 0 0;display:grid;grid-template-columns:1fr 1fr;gap:13px}
    .check-list li{font-size:14px;color:#40546b}
    .check-list li:before{content:"✓";color:var(--green);font-weight:900;margin-right:9px}
    .portal-card{background:linear-gradient(145deg,#edf5ff,#f8fbff);border:1px solid #dce9f7;border-radius:24px;padding:25px}
    .portal-window{background:#fff;border:1px solid var(--line);border-radius:15px;overflow:hidden;box-shadow:0 15px 35px rgba(20,60,100,.09)}
    .window-bar{height:38px;background:#f7f9fc;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:5px;padding:0 13px}
    .window-bar i{width:7px;height:7px;border-radius:50%;background:#c4d1df}
    .portal-content{padding:20px}
    .portal-content h3{margin:0 0 15px;color:var(--navy);font-size:16px}
    .portal-row{display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px solid #edf1f6;font-size:11px}
    .portal-row:last-child{border:0}
    .pill{font-size:9px;padding:4px 8px;border-radius:20px;background:#e4f8f1;color:#13845f;font-weight:800}
    .industries{background:var(--navy);color:white}
    .industries .section-head h2{color:white}
    .industries .section-head p{color:#c2d2e1}
    .industry-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
    .industry{border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.06);border-radius:13px;padding:18px 12px;text-align:center;font-size:13px;font-weight:700;color:#e6f0fa}
    .industry span{display:block;font-size:24px;margin-bottom:8px}
    .custom{background:#f3f8ff}
    .custom-box{background:linear-gradient(110deg,#e8f2ff,#f6fbff);border:1px solid #d8e8fa;border-radius:22px;padding:42px;display:flex;align-items:center;justify-content:space-between;gap:35px}
    .custom-box h2{max-width:610px;margin-top:0}
    .custom-box p{color:var(--muted);max-width:650px;margin-bottom:0}
    .cta{background:linear-gradient(120deg,#1769e0,#124b9d);color:#fff;text-align:center;padding:75px 0}
    .cta h2{color:#fff;margin-top:0}
    .cta p{color:#dceaff;max-width:650px;margin:0 auto 25px}
    .cta .btn{background:#fff;color:var(--blue);box-shadow:none}
    .cta .btn:hover{background:#eaf3ff}
    footer{background:#0b1b2d;color:#c4d2e0;padding:48px 0 22px}
    .footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:45px}
    footer .logo{color:#fff}
    footer p{font-size:13px;color:#a9b9ca;max-width:370px}
    footer h4{color:#fff;margin:0 0 13px}
    footer a{display:block;font-size:13px;margin:8px 0;color:#c4d2e0}
    footer a:hover{color:#fff}
    .copyright{border-top:1px solid rgba(255,255,255,.12);margin-top:35px;padding-top:18px;font-size:11px;color:#91a4b8;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
    @media(max-width:900px){
      .navlinks{gap:15px}.hero-grid{gap:30px}.steps{grid-template-columns:repeat(3,1fr)}
      .industry-grid{grid-template-columns:repeat(3,1fr)}.split{gap:35px}
    }
    @media(max-width:700px){
      .container{width:min(100% - 30px,560px)}.topbar .container{justify-content:center;text-align:center}
      .nav{height:66px}.menu-toggle{display:block}.navlinks{display:none;position:absolute;top:66px;left:0;right:0;background:#fff;padding:18px 22px 24px;border-bottom:1px solid var(--line);flex-direction:column;align-items:stretch;gap:16px}
      .navlinks.open{display:flex}.navlinks .btn{text-align:center}
      .hero{padding:62px 0 75px}.hero-grid{grid-template-columns:1fr;gap:48px}h1{letter-spacing:-1.5px}
      .dashboard-wrap{max-width:520px;margin:auto;width:100%}.floating-note{right:-5px}
      section{padding:63px 0}.feature-grid{grid-template-columns:1fr 1fr}.steps{grid-template-columns:repeat(2,1fr)}
      .split{grid-template-columns:1fr}.check-list{grid-template-columns:1fr 1fr}
      .industry-grid{grid-template-columns:repeat(2,1fr)}.custom-box{padding:28px;display:block}.custom-box .btn{margin-top:22px}
      .footer-grid{grid-template-columns:1fr 1fr;gap:28px}.footer-grid>div:first-child{grid-column:1/-1}
    }
    @media(max-width:430px){
      .feature-grid{grid-template-columns:1fr}.hero-actions .btn{width:100%}.stats{gap:5px}.stat{padding:9px}.stat b{font-size:17px}
      .steps{gap:8px}.step{padding:15px 8px}.check-list{grid-template-columns:1fr}.industry-grid{gap:8px}
      .footer-grid{grid-template-columns:1fr}.footer-grid>div:first-child{grid-column:auto}
    }
  </style>
</head>
